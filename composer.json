{
    "name": "skrybe/sdk-php",
    "description": "Official PHP SDK for the Skrybe email marketing API",
    "type": "library",
    "license": "MIT",
    "keywords": ["skrybe", "email", "marketing", "newsletter", "api", "sdk"],
    "homepage": "https://github.com/skry-be/skrybe-sdk-php",
    "support": {
        "issues": "https://github.com/skry-be/skrybe-sdk-php/issues",
        "source": "https://github.com/skry-be/skrybe-sdk-php"
    },
    "require": {
        "php": "~8.2.35 || ~8.3.36 || ~8.4.27 || ^8.5.12",
        "guzzlehttp/guzzle": "^7.0",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Skrybe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Skrybe\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.22"
    },
    "scripts": {
        "test": "phpunit"
    }
}
